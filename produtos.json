document.addEventListener('DOMContentLoaded', () => {
  const menu = document.getElementById('menu');
  
  // Logo
  document.getElementById('logo').src = "https://i.imgur.com/G7vV1V.webp";

  const dados = [
    {
      "categoria": "SMASH LANCHES",
      "itens": [
        {"nome": "SMASH BURGUES", "preco": 12.00, "imagem": "https://i.imgur.com/8k2Qm1A.webp"},
        {"nome": "SMASH BACON", "preco": 16.00, "imagem": "https://i.imgur.com/5T1vE9F.webp"}
      ]
    },
    {
      "categoria": "BEBIDAS",
      "itens": [
        {"nome": "COCA 600ML", "preco": 6.00, "imagem": "https://i.imgur.com/K1rR7R.webp"}
      ]
    }
  ];

  dados.forEach(categoria => {
    const section = document.createElement('section');
    section.classList.add('categoria');
    let htmlItens = '';
    categoria.itens.forEach(item => {
      htmlItens += `
        <div class="item">
          <img src="${item.imagem}" alt="${item.nome}">
          <div class="info">
            <h3>${item.nome}</h3>
            <p>R$ ${item.preco.toFixed(2).replace('.', ',')}</p>
          </div>
        </div>
      `;
    });
    section.innerHTML = `<h2>${categoria.categoria}</h2>` + htmlItens;
    menu.appendChild(section);
  });
});
